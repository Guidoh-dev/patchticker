{
  "name": "patchticker",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.3.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "overrides": {
    "proxy-addr": "2.0.8"
  },
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "audit": "npm audit --workspaces --audit-level=moderate",
    "audit:fix": "npm audit fix --workspaces",
    "test": "cd backend && npm test",
    "check:launch": "node scripts/production-check.js",
    "check:launch:strict": "node scripts/production-check.js --strict",
    "search:notify": "node scripts/submit-indexnow.js",
    "launch:verify": "npm run build && npm test && npm run audit && npm run check:launch"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
