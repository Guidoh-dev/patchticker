{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchticker.example/schemas/update-feed-item.schema.json",
  "title": "UpdateFeedItem",
  "description": "Canonical normalized software, driver, firmware, and platform release item.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "canonicalKey", "provider", "product", "title", "version", "channel", "releaseTypes", "severity", "rollout", "targets", "tags", "summary", "highlights", "changelog", "cveIds", "sources", "downloads", "timestamps", "parser"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "canonicalKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provider": { "$ref": "#/$defs/namedEntity" },
    "product": { "$ref": "#/$defs/namedProduct" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "version": { "$ref": "#/$defs/version" },
    "channel": { "enum": ["stable", "extended-stable", "preview", "beta", "dev", "canary", "insider", "hotfix", "other"] },
    "releaseTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["security", "feature", "hotfix", "driver", "firmware", "quality", "maintenance", "beta", "other"] }
    },
    "severity": { "enum": ["none", "low", "medium", "high", "critical", "unknown"] },
    "exploitedInTheWild": { "type": "boolean" },
    "mandatory": { "type": "boolean" },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "phased"],
      "properties": {
        "status": { "enum": ["announced", "rolling-out", "available", "paused", "withdrawn", "superseded"] },
        "phased": { "type": "boolean" },
        "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "regions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 64 } }
      }
    },
    "targets": { "type": "array", "items": { "$ref": "#/$defs/target" } },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" } },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "highlights": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "changelog": { "type": "array", "items": { "$ref": "#/$defs/changelogItem" } },
    "cveIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "downloads": { "type": "array", "items": { "$ref": "#/$defs/download" } },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releasedAt", "sourceFirstSeenAt", "indexedAt", "updatedAt"],
      "properties": {
        "announcedAt": { "$ref": "#/$defs/dateTime" },
        "releasedAt": { "$ref": "#/$defs/dateTime" },
        "rolloutStartedAt": { "$ref": "#/$defs/dateTime" },
        "sourceFirstSeenAt": { "$ref": "#/$defs/dateTime" },
        "indexedAt": { "$ref": "#/$defs/dateTime" },
        "updatedAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "method", "confidence", "reviewed"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "version": { "type": "string", "minLength": 1, "maxLength": 50 },
        "method": { "enum": ["deterministic", "llm-assisted", "human"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewed": { "type": "boolean" }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indexingLatencySeconds"],
      "properties": {
        "indexingLatencySeconds": { "type": "number", "minimum": 0 },
        "intentHalfLifeSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "peakIntentWindowSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "trackingEfficiencyScore": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  },
  "$defs": {
    "dateTime": { "type": "string", "format": "date-time" },
    "uri": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "namedEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "namedProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "family": { "type": "string", "maxLength": 120 }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "scheme"],
      "properties": {
        "raw": { "type": "string", "minLength": 1, "maxLength": 120 },
        "scheme": { "enum": ["semver", "calver", "build", "kb", "firmware", "opaque"] },
        "normalized": { "type": "string", "maxLength": 120 },
        "build": { "type": "string", "maxLength": 120 },
        "previous": { "type": "string", "maxLength": 120 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string", "maxLength": 80 },
        "osVersion": { "type": "string", "maxLength": 120 },
        "architecture": { "enum": ["x86", "x64", "arm", "arm64", "universal", "other"] },
        "deviceFamily": { "type": "string", "maxLength": 120 },
        "hardwareIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 160 } },
        "locale": { "type": "string", "maxLength": 35 }
      }
    },
    "changelogItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title"],
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "kind": { "enum": ["highlight", "fixed", "known-issue", "security", "breaking-change", "deprecated", "other"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "maxLength": 5000 },
        "affected": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
        "cveIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$" } },
        "issueUrls": { "type": "array", "items": { "$ref": "#/$defs/uri" } }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "url", "kind", "fetchedAt"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
        "externalId": { "type": "string", "maxLength": 200 },
        "url": { "$ref": "#/$defs/uri" },
        "kind": { "enum": ["official-api", "official-rss", "official-html", "official-pdf", "webhook", "secondary"] },
        "publishedAt": { "$ref": "#/$defs/dateTime" },
        "fetchedAt": { "$ref": "#/$defs/dateTime" },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "language": { "type": "string", "maxLength": 35 }
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "official"],
      "properties": {
        "url": { "$ref": "#/$defs/uri" },
        "label": { "type": "string", "maxLength": 120 },
        "operatingSystem": { "type": "string", "maxLength": 80 },
        "architecture": { "enum": ["x86", "x64", "arm", "arm64", "universal", "other"] },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "official": { "type": "boolean" }
      }
    }
  }
}
